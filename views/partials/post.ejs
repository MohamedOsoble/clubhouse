<div class="post-container">
  <% if(locals.user.type){ %>
  <h3>Author: <%= post.author_name%></h3>
  <% } else{ %>
  <h3>Author: Anonymous (Must be a member to see)</h3>
  <% } %>
  <h3>Title: <%= post.post_title%></h3>
  <h3>Posted on: <%= post.post_date %></h3>
  <p><%= post.post_content %></p>
  <% if(locals.user.type === 'Admin'){ %>
  <form action="/delete-post" method="POST">
    <input type="hidden" name="postid" id="postid" value="<%=post.post_id %>">
    <button onclick="confirmDelete(event)">Delete post</button>
    <script>
      function confirmDelete(e) {
        let deletePost = confirm('Are you sure you want to delete this post?');
        if (!deletePost) {
          e.preventDefault()
        };
      };
    </script>
  </form>
  <%}%>
</div>